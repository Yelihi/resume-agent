# Copy outside the repository and chmod 600. Fill every placeholder.
# Disabled until a local restic repository is prepared; use local to enable.
# Remote repositories are rejected to prevent cloud storage overage charges.
RESUME_BACKUP_MODE=disabled
RESUME_DATA_DIR='__ABSOLUTE_EXTERNAL_DATA_DIRECTORY__'
# Pre-create this directory on the mounted storage with chmod 700, owned by the
# backup user. Backup refuses missing/insecure paths and never creates mounts.
RESUME_BACKUP_STAGING_DIR='__ABSOLUTE_EXTERNAL_STAGING_DIRECTORY__'
RESTIC_BIN='__ABSOLUTE_RESTIC_BINARY_PATH__'
# Initialize this absolute directory with restic init and chmod 700 first.
# Keep it outside the repository, data and staging directories. Prefer a second
# physical disk: a backup on the data SSD does not survive that SSD failing.
# Do not use a cloud-backed or metered network filesystem mount.
RESTIC_REPOSITORY='__ABSOLUTE_LOCAL_RESTIC_REPOSITORY__'
RESTIC_PASSWORD_FILE='__ABSOLUTE_PRIVATE_PASSWORD_FILE__'

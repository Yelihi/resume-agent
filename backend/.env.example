OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# local keeps the existing single-user development workflow.
# server requires all settings below and never uses OPENAI_API_KEY.
RESUME_DEPLOYMENT_MODE=local
# Absolute paths outside this Git repository. Create the Fernet key explicitly
# and restrict it to its owner (chmod 600); startup never generates a key.
RESUME_DATA_DIR=
RESUME_KEY_FILE=
RESUME_PUBLIC_ORIGIN=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Direct Tunnel: cf-access-jwt-assertion. Cloudflare frontend Worker:
# x-resume-user-jwt; CF_ACCESS_AUD must still identify the frontend user app.
RESUME_ACCESS_ASSERTION_HEADER=cf-access-jwt-assertion
# Server accounts require explicit host-only invitations before their first login:
# cd backend && .venv/bin/python -m scripts.manage_users --data-dir /PRIVATE/DATA invite EMAIL
# Optional: verified internal account.id after the operator's first login.
# Enables only backup status viewing; never grants access to another user's data.
RESUME_OPERATOR_ID=
